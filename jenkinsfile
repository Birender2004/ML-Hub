
pipeline {
    agent any

    stages {
        stage('Git LFS') {
            steps {
                sh 'git lfs pull'
            }
        }

        stage('Verify Project') {
            steps {
                sh '''
                    echo "ML Hub source successfully checked out"
                    git lfs ls-files
                '''
            }
        }

        stage('Gitleaks Secret Scan') {
            steps {
                sh '''
                    echo "Scanning backend for secrets..."

                    docker run --rm \
                        --volumes-from jenkins \
                        -w "$WORKSPACE" \
                        zricethezav/gitleaks:v8.30.1 \
                        dir --redact backend

                    echo "Scanning frontend for secrets..."

                    docker run --rm \
                        --volumes-from jenkins \
                        -w "$WORKSPACE" \
                        zricethezav/gitleaks:v8.30.1 \
                        dir --redact frontend

                    echo "Gitleaks scans completed successfully."
                '''
            }
        }

        stage('Bandit Security Scan') {
            steps {
                sh '''
                    echo "Running Bandit Python security scan..."

                    docker run --rm \
                        --volumes-from jenkins \
                        -w "$WORKSPACE" \
                        ghcr.io/pycqa/bandit/bandit:latest \
                        -r backend/app \
                        -f txt \
                        --exit-zero

                    echo "Bandit scan completed. Review findings above."
                '''
            }
        }

        stage('Backend Tests') {
            steps {
                sh '''
                    docker run --rm \
                        --volumes-from jenkins \
                        -w "$WORKSPACE/backend" \
                        python:3.11-slim \
                        bash -c "
                            pip install \
                                --default-timeout=300 \
                                --retries=10 \
                                --no-cache-dir \
                                -r requirements.txt pytest \
                            && PYTHONPATH=. pytest
                        "
                '''
            }
        }

        stage('Frontend Build') {
            steps {
                sh '''
                    docker run --rm \
                        --volumes-from jenkins \
                        -w "$WORKSPACE/frontend" \
                        node:20-alpine \
                        sh -c "npm ci && npm run build"
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    docker build \
                        -t birender2026/ml-hub-backend:1.0.0 \
                        ./backend

                    docker build \
                        -t birender2026/ml-hub-frontend:1.0.0 \
                        ./frontend
                '''
            }
        }

        stage('Trivy Image Security Scan') {
            steps {
                sh '''
                    mkdir -p reports

                    echo "Scanning backend image with Trivy..."

                    docker run --rm \
                        --volumes-from jenkins \
                        -v trivy-cache:/root/.cache/ \
                        -w "$WORKSPACE" \
                        aquasec/trivy:0.74.0 \
                        image \
                        --timeout 5m \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --format table \
                        --exit-code 0 \
                        --output reports/trivy-backend.txt \
                        birender2026/ml-hub-backend:1.0.0

                    echo "Scanning frontend image with Trivy..."

                    docker run --rm \
                        --volumes-from jenkins \
                        -v trivy-cache:/root/.cache/ \
                        -w "$WORKSPACE" \
                        aquasec/trivy:0.74.0 \
                        image \
                        --timeout 5m \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --format table \
                        --exit-code 0 \
                        --output reports/trivy-frontend.txt \
                        birender2026/ml-hub-frontend:1.0.0

                    echo "Trivy scans completed."
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/trivy-*.txt',
                                     allowEmptyArchive: true
                }
            }
        }

        stage('Push Docker Images') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push birender2026/ml-hub-backend:1.0.0
                        docker push birender2026/ml-hub-frontend:1.0.0

                        docker logout
                    '''
                }
            }
        }
    }
}

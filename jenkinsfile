pipeline {
    agent any

    stages {

        stage('Git LFS') {
            steps {
                sh 'git lfs pull'
            }
        }

        stage('Verify Project') {
            steps {
                sh 'echo "ML Hub source successfully checked out"'
                sh 'git lfs ls-files'
            }
        }

        stage('Backend Tests') {
            steps {
                sh '''
                    docker run --rm \
                        --volumes-from jenkins \
                        -w "$WORKSPACE/backend" \
                        python:3.11-slim \
                        bash -c "pip install --no-cache-dir -r requirements.txt && pytest"
                '''
            }
        }

        stage('Frontend Build') {
            steps {
                sh '''
                    docker run --rm \
                        --volumes-from jenkins \
                        -w "$WORKSPACE/frontend" \
                        node:20-alpine \
                        sh -c "npm ci && npm run build"
                '''
            }
        }
    }
}

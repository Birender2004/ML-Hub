# ============================================================
# ML HUB - ROOT .gitignore
# ============================================================


# ============================================================
# 1. ENVIRONMENT VARIABLES / SECRETS
# ============================================================

.env
.env.*
!.env.example

*.env
*.secret
*.secrets

# Secret/config files
secrets/
secret/
credentials/
credentials.json
service-account.json

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx
*.crt


# ============================================================
# 2. PYTHON
# ============================================================

__pycache__/
*.py[cod]
*$py.class

*.so

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

.pyre/
.pytype/

.ipynb_checkpoints/


# ============================================================
# 3. PYTHON VIRTUAL ENVIRONMENTS
# ============================================================

venv/
env/
ENV/
.venv/
myenv/
backend/venv/
backend/myenv/

# Other common environment names
virtualenv/
.python-version


# ============================================================
# 4. FASTAPI / UVICORN / APPLICATION LOGS
# ============================================================

*.log
logs/
*.pid


# ============================================================
# 5. NODE / REACT / VITE
# ============================================================

node_modules/
frontend/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

# Vite build output
dist/
frontend/dist/
build/
frontend/build/

# Vite cache
.vite/
frontend/.vite/


# ============================================================
# 6. IDE / EDITOR FILES
# ============================================================

.idea/
.vscode/
*.iml

# VS Code local configuration
.history/

# Sublime
*.sublime-workspace
*.sublime-project


# ============================================================
# 7. OPERATING SYSTEM FILES
# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory


# ============================================================
# 8. DATABASE FILES / LOCAL DATABASE DATA
# ============================================================

*.db
*.sqlite
*.sqlite3

# MySQL dumps / backups
*.sql
*.dump
*.bak

# Local database folders
database/data/
db_data/
mysql_data/
mysql/
data/


# ============================================================
# 9. USER UPLOADS
# ============================================================

# Do NOT push potentially private user-uploaded files
uploads/
backend/uploads/
frontend/uploads/

# Temporary uploaded files
tmp/
temp/
backend/tmp/


# ============================================================
# 10. CACHE / TEMPORARY FILES
# ============================================================

.cache/
.cache-loader/
.parcel-cache/
temp/
tmp/

*.tmp
*.temp
*.swp
*.swo


# ============================================================
# 11. PYTHON BUILD / PACKAGE OUTPUT
# ============================================================

build/
dist/
*.egg-info/
.eggs/

pip-wheel-metadata/


# ============================================================
# 12. JUPYTER / DATA SCIENCE TEMP FILES
# ============================================================

.ipynb_checkpoints/

# Local experiment outputs
experiments/output/
notebooks/output/


# ============================================================
# 13. ML EXPERIMENT / TRAINING OUTPUT
# ============================================================

# TensorFlow / Keras temporary files
checkpoint/
checkpoints/

# Training logs
tensorboard/
runs/

# Temporary model outputs
model_outputs/
training_outputs/


# ============================================================
# 14. LOCAL TEST FILES
# ============================================================

# Personal testing scripts / temporary experiments
test_local.py
test_private.py

# If you create local test data
test_data/
local_test_data/


# ============================================================
# 15. PERSONAL / MACHINE-SPECIFIC FILES
# ============================================================

*.local
*.local.json
*.local.yaml
*.local.yml

local/
private/
personal/


# ============================================================
# 16. DOCKER
# ============================================================

# Local Docker override files
docker-compose.override.yml
docker-compose.local.yml

# Docker environment files
docker.env
.env.docker


# ============================================================
# 17. KUBERNETES LOCAL / SECRET FILES
# ============================================================

# Never commit actual Kubernetes secrets
k8s/secrets/
kubernetes/secrets/

*-secret.yaml
*-secrets.yaml

# Local kube configuration
.kube/
kubeconfig
kubeconfig.yaml


# ============================================================
# 18. JENKINS LOCAL DATA
# ============================================================

jenkins_home/
jenkins_data/


# ============================================================
# 19. GENERATED DOCUMENTS / EXPORTS
# ============================================================

*.pdf
*.docx
*.xlsx

# Uncomment if you want to keep project documentation PDFs
# docs/generated/


# ============================================================
# 20. LARGE / LOCAL DATASETS
# ============================================================

# Uncomment these if datasets are local-only
# datasets/
# data/
# *.csv
# *.zip
# *.rar


# ============================================================
# 21. PERSONAL BACKUPS
# ============================================================

*.backup
*.old
*.orig

backup/
backups/


# ============================================================
# 22. FRONTEND LOCAL ENVIRONMENT
# ============================================================

frontend/.env
frontend/.env.*
!frontend/.env.example


# ============================================================
# 23. BACKEND LOCAL ENVIRONMENT
# ============================================================

backend/.env
backend/.env.*
!backend/.env.example


# ============================================================
# 24. COMMON SECRET FILE NAMES
# ============================================================

config.local.*
settings.local.*
database.local.*
firebase-adminsdk-*.json


# ============================================================
# END
# ============================================================

# Fashion recommender images
backend/trained_models/fashion/images/

# Large ML model artifacts
# backend/trained_models/fashion/feature_list.pkl
# backend/trained_models/movie/similarity.pkl

# Fashion recommender images
backend/trained_models/fashion/images/